{
    "name": "dmlab/module-typesense-search",
    "description": "Registers Typesense as a selectable Magento search engine and implements the query side: translates a Magento search request into a Typesense query and returns matched IDs plus aggregations. Serves quick/advanced search, category listings and layered navigation. Drop-in replacement for OpenSearch/Elasticsearch, free and uncapped.",
    "keywords": [
        "magento2",
        "magento2-module",
        "magento 2",
        "typesense",
        "search engine",
        "opensearch replacement",
        "elasticsearch alternative",
        "layered navigation",
        "catalog search",
        "faceted search",
        "graphql"
    ],
    "homepage": "https://github.com/dmlab-work/module-typesense-search",
    "type": "magento2-module",
    "license": "OSL-3.0",
    "version": "0.3.0",
    "support": {
        "issues": "https://github.com/dmlab-work/module-typesense-search/issues",
        "source": "https://github.com/dmlab-work/module-typesense-search"
    },
    "require": {
        "php": "~8.2.0||~8.3.0||~8.4.0||~8.5.0",
        "magento/framework": "^103.0.7",
        "magento/module-search": "^101.1.7",
        "magento/module-advanced-search": "^100.4.5",
        "magento/module-catalog-search": "^102.0.7",
        "magento/module-catalog": "^104.0.7",
        "magento/module-customer": "^103.0.7",
        "magento/module-store": "^101.1.7",
        "magento/module-config": "^101.2.7",
        "magento/module-elasticsearch": "^101.0.7",
        "psr/log": "^2.0||^3.0",
        "dmlab/module-typesense-core": "^0.2.0",
        "dmlab/module-typesense-indexer": "^0.2.0"
    },
    "require-dev": {
        "phpunit/phpunit": "^11.5||^12.5"
    },
    "suggest": {
        "dmlab/module-typesense-instant-search": "Search-as-you-type dropdown in the storefront header, served by Typesense"
    },
    "autoload": {
        "files": [
            "registration.php"
        ],
        "psr-4": {
            "DmLab\\TypesenseSearch\\": ""
        }
    }
}
