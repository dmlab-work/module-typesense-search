<config xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:noNamespaceSchemaLocation="urn:magento:framework:ObjectManager/etc/config.xsd">
    <!-- Engine client + options; Magento\Elasticsearch\Model\Config paths do not apply to Typesense. -->
    <type name="Magento\AdvancedSearch\Model\Client\ClientResolver">
        <arguments>
            <argument name="clientFactories" xsi:type="array">
                <item name="typesense" xsi:type="string">DmLab\TypesenseSearch\Model\Client\ClientFactory</item>
            </argument>
            <argument name="clientOptions" xsi:type="array">
                <item name="typesense" xsi:type="string">DmLab\TypesenseSearch\Model\Client\ClientOptions</item>
            </argument>
        </arguments>
    </type>

    <!-- Connection validator, run by setup:upgrade. -->
    <type name="Magento\Search\Model\SearchEngine\Validator">
        <arguments>
            <argument name="engineValidators" xsi:type="array">
                <item name="typesense" xsi:type="object">DmLab\TypesenseSearch\Setup\Validator</item>
            </argument>
        </arguments>
    </type>

    <!-- Engine identity. `typesense` mirrors DmLab\TypesenseIndexer\Api\EngineCode::ENGINE (di cannot reference a constant). -->

    <!-- engineList feeds isElasticsearchEnabled(), which gates the fulltext indexer wiring; no ES server needed. -->
    <type name="Magento\Elasticsearch\Model\Config">
        <arguments>
            <argument name="engineList" xsi:type="array">
                <item name="typesense" xsi:type="string">typesense</item>
            </argument>
        </arguments>
    </type>

    <!-- Engine is a valid choice for CatalogSearch's engine resolver. -->
    <type name="Magento\Search\Model\EngineResolver">
        <arguments>
            <argument name="engines" xsi:type="array">
                <item name="typesense" xsi:type="string">typesense</item>
            </argument>
        </arguments>
    </type>

    <!-- Admin dropdown label: Stores → Configuration → Catalog → Catalog Search. -->
    <type name="Magento\Search\Model\Adminhtml\System\Config\Source\Engine">
        <arguments>
            <argument name="engines" xsi:type="array">
                <item sortOrder="50" name="typesense" xsi:type="string">Typesense</item>
            </argument>
        </arguments>
    </type>

    <!-- Max page size the engine will return in one request. -->
    <type name="Magento\Search\Model\Search\PageSizeProvider">
        <arguments>
            <argument name="pageSizeBySearchEngine" xsi:type="array">
                <item name="typesense" xsi:type="number">10000</item>
            </argument>
        </arguments>
    </type>

    <!-- Engine-agnostic Magento\Elasticsearch classes, shared by both bundled ES engines. -->

    <!-- Deps are only Visibility + IndexScopeResolver — no ES protocol. -->
    <type name="Magento\CatalogSearch\Model\ResourceModel\EngineProvider">
        <arguments>
            <argument name="engines" xsi:type="array">
                <item name="typesense" xsi:type="string">Magento\Elasticsearch\Model\ResourceModel\Engine</item>
            </argument>
        </arguments>
    </type>

    <!-- Deps are only Catalog\Config + Visibility — no ES protocol. -->
    <type name="Magento\CatalogSearch\Model\Advanced\ProductCollectionPrepareStrategyProvider">
        <arguments>
            <argument name="strategies" xsi:type="array">
                <item name="typesense" xsi:type="object">Magento\Elasticsearch\Model\Advanced\ProductCollectionPrepareStrategy</item>
            </argument>
        </arguments>
    </type>

    <!-- Layered-navigation collection factories: plain CatalogSearch collections. -->
    <virtualType name="elasticsearchLayerCategoryItemCollectionProvider" type="Magento\Elasticsearch\Model\Layer\Category\ItemCollectionProvider">
        <arguments>
            <argument name="factories" xsi:type="array">
                <item name="typesense" xsi:type="object">elasticsearchCategoryCollectionFactory</item>
            </argument>
        </arguments>
    </virtualType>
    <virtualType name="elasticsearchLayerSearchItemCollectionProvider" type="Magento\Elasticsearch\Model\Layer\Search\ItemCollectionProvider">
        <arguments>
            <argument name="factories" xsi:type="array">
                <item name="typesense" xsi:type="object">elasticsearchFulltextSearchCollectionFactory</item>
            </argument>
        </arguments>
    </virtualType>
    <type name="Magento\CatalogSearch\Model\Search\ItemCollectionProvider">
        <arguments>
            <argument name="factories" xsi:type="array">
                <item name="typesense" xsi:type="object">elasticsearchAdvancedCollectionFactory</item>
            </argument>
        </arguments>
    </type>

    <!-- typesense-indexer's handler/structure (single writer), wired like module-open-search does for ES. -->
    <type name="Magento\CatalogSearch\Model\Indexer\IndexerHandlerFactory">
        <arguments>
            <argument name="handlers" xsi:type="array">
                <item name="typesense" xsi:type="string">DmLab\TypesenseIndexer\Model\Indexer\IndexerHandler</item>
            </argument>
        </arguments>
    </type>
    <type name="Magento\CatalogSearch\Model\Indexer\IndexStructureFactory">
        <arguments>
            <argument name="structures" xsi:type="array">
                <item name="typesense" xsi:type="string">DmLab\TypesenseIndexer\Model\Indexer\IndexStructure</item>
            </argument>
        </arguments>
    </type>

    <!-- Query modifier pipeline (di-sorted, never a preference); ships empty. Example in README. -->
    <type name="DmLab\TypesenseSearch\SearchAdapter\Query\QueryModifier">
        <arguments>
            <argument name="modifiers" xsi:type="array"/>
        </arguments>
    </type>

    <!-- Response processor pipeline: rewrites the raw response before mapping; ships empty. Example in README. -->
    <type name="DmLab\TypesenseSearch\SearchAdapter\Response\ResponseProcessor">
        <arguments>
            <argument name="processors" xsi:type="array"/>
        </arguments>
    </type>

    <!-- Price slider data provider + interval; Magento's ES ones are ES-only. -->
    <type name="Magento\Framework\Search\Dynamic\DataProviderFactory">
        <arguments>
            <argument name="dataProviders" xsi:type="array">
                <item name="typesense" xsi:type="string">DmLab\TypesenseSearch\SearchAdapter\Dynamic\DataProvider</item>
            </argument>
        </arguments>
    </type>
    <type name="Magento\Framework\Search\Dynamic\IntervalFactory">
        <arguments>
            <argument name="intervals" xsi:type="array">
                <item name="typesense" xsi:type="string">DmLab\TypesenseSearch\SearchAdapter\Aggregation\Interval</item>
            </argument>
        </arguments>
    </type>

    <!-- "Did you mean". Leaving `typesense` unregistered fatals the search box. -->
    <type name="Magento\AdvancedSearch\Model\SuggestedQueries">
        <arguments>
            <argument name="data" xsi:type="array">
                <item name="typesense" xsi:type="string">DmLab\TypesenseSearch\Model\DataProvider\Suggestions</item>
            </argument>
        </arguments>
    </type>

    <!-- Engine query adapter, selected by engine name. -->
    <type name="Magento\Search\Model\AdapterFactory">
        <arguments>
            <argument name="adapters" xsi:type="array">
                <item name="typesense" xsi:type="string">DmLab\TypesenseSearch\SearchAdapter\Adapter</item>
            </argument>
        </arguments>
    </type>

    <!-- Never disabled="true" — that would break switching back to OpenSearch. -->
    <type name="Magento\Elasticsearch\Model\Indexer\Fulltext\Plugin\Category\Product\Attribute">
        <plugin name="dmlab_typesense_search_neutralise_es_attribute"
                type="DmLab\TypesenseSearch\Plugin\Elasticsearch\AttributeIndexerNeutralizePlugin"/>
    </type>

    <!-- Indexer schema changes (alias swap, in-place attribute PATCH) drop the cached alias schema. -->
    <type name="DmLab\TypesenseCore\Model\Collection\AliasManager">
        <plugin name="dmlab_typesense_search_schema_cache_invalidation"
                type="DmLab\TypesenseSearch\Plugin\Indexer\SchemaCacheInvalidationPlugin"/>
    </type>
    <type name="DmLab\TypesenseIndexer\Model\Plugin\AttributeSaveHandler">
        <plugin name="dmlab_typesense_search_schema_cache_invalidation"
                type="DmLab\TypesenseSearch\Plugin\Indexer\SchemaCacheInvalidationPlugin"/>
    </type>

    <!-- Do not copy open-search's ES-internal proxies (ProductFieldMapperProxy, ClientFactoryProxy, ...):
         they serve the ES IndexerHandler, which this engine does not use. -->
</config>
